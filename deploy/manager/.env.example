# TLS Classify — management (.env)
# Скопируйте: cp .env.example .env

MANAGER_PORT=5357
WORKER_LEASE_MINUTES=30
LOG_TEXT_MAX_CHARS=524288

# SMB (как в RAD/CS)
SMB_HOST_1=172.16.16.126
SMB_USER_1=
SMB_PASSWORD_1=
SMB_SHARE_FOLDER_1=share

# Имя в веб-интерфейсе = путь монтирования в контейнере
STORAGE_ROOTS=172.16.16.126=/172.16.16.126

DATABASE_URL=sqlite:////data/cluster.db
CORS_ORIGINS=*
