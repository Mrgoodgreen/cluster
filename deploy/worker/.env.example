# TLS Classify — GPU worker (.env)
# Скопируйте: cp .env.example .env

# Management TLS Classify (порт 5357, не 5257)
MANAGER_URL=http://192.168.0.111:5357

WORKER_ID=gpu-node-01
CARS_TO=91
NOISE_TO=7
WORKER_MODE=gpu
WORKER_POLL_IDLE_SEC=5
# Bundled RF trained on three etalons; set empty/override only for diagnostics.
RF_REFINER=/opt/tls/pipeline/models/etalon_rf_scene_20260909.pkl
# Shared scene features; prediction batches never redefine spatial context.
RF_CONTEXT_MODE=scene
# One outer leaf per GPU. Inner HDBSCAN performs its own VRAM tiling.
TILE_WORKERS=1
# 0: automatic budget. In scene mode, positive values cap prediction batches
# (at most 1M points), not the size of the shared scene context.
RF_MAX_TILE_POINTS=0

# SMB — те же значения, что у management
SMB_HOST_1=172.16.16.126
SMB_USER_1=tester
SMB_PASSWORD_1=password
SMB_SHARE_FOLDER_1=share
